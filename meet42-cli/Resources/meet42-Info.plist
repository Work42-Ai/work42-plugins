<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  meet42-Info.plist — embedded into the standalone meet42 binary's __TEXT
  __info_plist section via -sectcreate at link time (meet42-plugin-conversion,
  M1/s7), so TCC can read the usage descriptions for a plain CLI binary that
  has no .app bundle. See scripts/build-meet42.sh.
-->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.work42.meet42</string>
    <key>CFBundleName</key>
    <string>meet42</string>
    <key>CFBundleExecutable</key>
    <string>meet42</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>meet42 reads your calendar to list meetings and prepare sessions for them.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>meet42 records meeting audio locally to produce a private transcript.</string>
    <key>NSScreenCaptureDescription</key>
    <string>meet42 captures system audio during a meeting to transcribe all participants.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>meet42 transcribes meeting audio on-device using the system speech recognizer.</string>
</dict>
</plist>
