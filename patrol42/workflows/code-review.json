{
  "slug": "code-review",
  "name": "Code Review",
  "description": "The built-in code-review lifecycle: Intake, AI Review, Human Review, Done.",
  "stages": [
    {
      "name": "Intake",
      "ordinal": 1,
      "is_initial": true,
      "is_terminal": false,
      "entry_prompt": "You're in Intake. Resolve the GitHub PR (github/prs) and read its description for linked Jira (jira/url) and Figma (figma/links) tickets, plus any associated PRs -- attach each one you find to github/prs. If multiple repositories are involved, ask the user whether to check out the other PRs so the whole change can be tested together. When intake is complete, run `work42 transition \"AI Review\"`.",
      "entry_gate": null,
      "icon": "tray.and.arrow.down",
      "color_light": "#0284C7",
      "color_dark": "#66C8FF",
      "model": "sonnet",
      "provider": "claude"
    },
    {
      "name": "AI Review",
      "ordinal": 2,
      "is_initial": false,
      "is_terminal": false,
      "entry_prompt": "You're in AI Review. Build ONE explainer artifact covering the PR's most important changes, giving every highlighted item a source deep-link (prefer a GitHub PR hunk link, then a blob permalink, then a local file:line -- see the work42-source-links skill) so clicking it opens straight to that exact change. When the artifact is published, write review/artifact_id to storage, then run `work42 transition \"Human Review\"`.",
      "entry_gate": null,
      "icon": "sparkle.magnifyingglass",
      "color_light": "#6D28D9",
      "color_dark": "#9D6BFF",
      "model": "opus[1m]",
      "provider": "claude"
    },
    {
      "name": "Human Review",
      "ordinal": 3,
      "is_initial": false,
      "is_terminal": false,
      "entry_prompt": "The AI Review artifact is published -- you're now in Human Review. Help the human read it: answer clarifying questions and leave comments on the PR when asked. Once every attached PR merges, run `work42 transition \"Done\"`.",
      "entry_gate": "{\"namespace\":\"review\",\"key\":\"artifact_id\",\"op\":\"exists\"}",
      "icon": "eye",
      "color_light": "#C2410C",
      "color_dark": "#FFA060",
      "model": "sonnet",
      "provider": "claude"
    },
    {
      "name": "Done",
      "ordinal": 4,
      "is_initial": false,
      "is_terminal": true,
      "entry_prompt": "Every attached PR has merged -- this code review is Done. No further action needed.",
      "entry_gate": "{\"and\":[{\"exists\":\"github/prs\"},{\"forAll\":\"github/prs\",\"where\":{\"field\":\"status\",\"op\":\"equals\",\"value\":\"merged\"}}]}",
      "icon": "checkmark.circle.fill",
      "color_light": "#15803D",
      "color_dark": "#4CDB73",
      "model": "sonnet",
      "provider": "claude"
    }
  ],
  "transitions": [
    { "from": "Intake", "to": "AI Review", "description": "intake is complete and the PR is ready to review" },
    { "from": "AI Review", "to": "Human Review", "description": "the AI Review explainer artifact is published" },
    { "from": "Human Review", "to": "Done", "description": "every attached PR has merged" },
    { "from": "AI Review", "to": "Intake", "description": "more intake is needed before reviewing" },
    { "from": "Human Review", "to": "Intake", "description": "the review needs to start over from intake" }
  ],
