{
  "slug": "meeting",
  "name": "Meeting",
  "description": "The built-in meeting lifecycle: Prepare for Meeting, In Meeting, Summary, Done -- driven by the recording lifecycle.",
  "stages": [
    {
      "name": "Prepare for Meeting",
      "ordinal": 1,
      "is_initial": true,
      "is_terminal": false,
      "entry_prompt": "You're in Prepare for Meeting. Fetch the context this meeting needs -- attendees, recent related threads, open tasks -- so it's ready before the meeting starts. Starting the recording writes meeting/started_at, which moves this session to In Meeting.",
      "entry_gate": null,
      "icon": "tray.and.arrow.down",
      "color_light": "#0284C7",
      "color_dark": "#66C8FF",
      "model": "sonnet",
      "provider": "claude"
    },
    {
      "name": "In Meeting",
      "ordinal": 2,
      "is_initial": false,
      "is_terminal": false,
      "entry_prompt": "The recording started -- you're now In Meeting, running on Haiku for fast live notes. Keep concise running notes as the conversation happens. Stopping the recording writes meeting/ended_at, which moves this session to Summary.",
      "entry_gate": "{\"namespace\": \"meeting\", \"key\": \"started_at\", \"op\": \"exists\"}",
      "icon": "waveform",
      "color_light": "#6D28D9",
      "color_dark": "#9D6BFF",
      "model": "haiku",
      "provider": "claude"
    },
    {
      "name": "Summary",
      "ordinal": 3,
      "is_initial": false,
      "is_terminal": false,
      "entry_prompt": "The recording stopped -- you're now in Summary. Write a clear recap to work42 storage as meeting/summary, then run `work42 transition \"Done\"`.",
      "entry_gate": "{\"namespace\": \"meeting\", \"key\": \"ended_at\", \"op\": \"exists\"}",
      "icon": "doc.text",
      "color_light": "#B45309",
      "color_dark": "#FFC766",
      "model": "sonnet",
      "provider": "claude"
    },
    {
      "name": "Done",
      "ordinal": 4,
      "is_initial": false,
      "is_terminal": true,
      "entry_prompt": "The recap is written -- this meeting is Done. No further action needed.",
      "entry_gate": "{\"namespace\": \"meeting\", \"key\": \"summary\", \"op\": \"exists\"}",
      "icon": "checkmark.circle.fill",
      "color_light": "#15803D",
      "color_dark": "#4CDB73",
      "model": "sonnet",
      "provider": "claude"
    }
  ],
  "transitions": [
    {
      "from": "Prepare for Meeting",
      "to": "In Meeting",
      "description": "the recording started (meeting/started_at written)"
    },
    {
      "from": "In Meeting",
      "to": "Summary",
      "description": "the recording stopped (meeting/ended_at written)"
    },
    {
      "from": "Summary",
      "to": "Done",
      "description": "the recap is written (meeting/summary written)"
    },
    {
      "from": "In Meeting",
      "to": "Prepare for Meeting",
      "description": "back out to prep (recording reset)"
    },
    {
      "from": "Summary",
      "to": "Prepare for Meeting",
      "description": "back out to prep (recording reset)"
    }
  ],
