{
  "slug": "linear42-product",
  "name": "linear42 product",
  "description": "Product shaping on Linear: Discover, Shape, Design (Figma), Ready. Product perspective only, no engineering. The shape is a Linear document, the design is linked Figma frames, and the user approves the handoff.",
  "stages": [
    {
      "name": "Discover",
      "ordinal": 1,
      "is_initial": true,
      "is_terminal": false,
      "entry_prompt": "You are in Discover. Your goal is to understand the problem from the user's side: who is affected, what they are trying to do, and what success looks like. Load the linear42-product skill, then the one for this issue's type (linear42-product-feature, linear42-product-bug or linear42-product-other). Product only: no files, APIs or implementation.",
      "entry_gate": null,
      "icon": "magnifyingglass",
      "color_light": "#0284C7",
      "color_dark": "#66C8FF",
      "model": "opus[1m]",
      "provider": "claude"
    },
    {
      "name": "Shape",
      "ordinal": 2,
      "is_initial": false,
      "is_terminal": false,
      "entry_prompt": "You are in Shape. Your goal is to turn the discovery into a product shape: the flows, the rules, and every edge case and failure state as the user experiences it, published as the Product Shape document on the Linear issue. Follow the type skill you loaded. Product only: no engineering.",
      "entry_gate": "{\"namespace\":\"shape\",\"key\":\"discovery_done\",\"op\":\"exists\"}",
      "icon": "square.stack.3d.up",
      "color_light": "#6D28D9",
      "color_dark": "#9D6BFF",
      "model": "opus[1m]",
      "provider": "claude"
    },
    {
      "name": "Design",
      "ordinal": 3,
      "is_initial": false,
      "is_terminal": false,
      "entry_prompt": "You are in Design. Your goal is to build the Figma frames that show the shape: every flow step, empty, loading, error and edge state, linked from the issue. Load the linear42-product-figma skill.",
      "entry_gate": "{\"namespace\":\"shape\",\"key\":\"doc\",\"op\":\"exists\"}",
      "icon": "pencil.and.ruler",
      "color_light": "#B45309",
      "color_dark": "#FFC766",
      "model": "opus[1m]",
      "provider": "claude"
    },
    {
      "name": "Ready",
      "ordinal": 4,
      "is_initial": false,
      "is_terminal": true,
      "entry_prompt": "You are in Ready. The shape and the Figma design are approved and linked on the Linear issue; nothing is left to do here. Engineering picks the issue up from Linear.",
      "entry_gate": "{\"and\":[{\"namespace\":\"figma\",\"key\":\"links\",\"op\":\"exists\"},{\"namespace\":\"shape\",\"key\":\"approved_at\",\"op\":\"exists\"}]}",
      "icon": "checkmark.circle.fill",
      "color_light": "#15803D",
      "color_dark": "#4CDB73",
      "model": "opus[1m]",
      "provider": "claude"
    }
  ],
  "transitions": [
    {
      "from": "Discover",
      "to": "Shape",
      "description": "discovery is written up and you are ready to shape the feature"
    },
    {
      "from": "Shape",
      "to": "Design",
      "description": "the Product Shape document is published and confirmed"
    },
    {
      "from": "Design",
      "to": "Ready",
      "description": "the Figma frames cover every flow and edge case and the user approved them"
    },
    {
      "from": "Design",
      "to": "Shape",
      "description": "the design exposed a gap in the shape"
    },
    {
      "from": "Shape",
      "to": "Discover",
      "description": "the problem itself turned out to be misunderstood"
    },
    {
      "from": "Ready",
      "to": "Shape",
      "description": "the user asked for changes after approval"
    }
  ],
