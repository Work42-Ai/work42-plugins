{
  "slug": "linear42-product",
  "name": "linear42 product",
  "description": "Debate the Linear item and iterate on product UI artifacts in Chat. Move the approved direction into Figma, validate behavior and edge cases, then hand off an agreed product shape. Product only.",
  "stages": [
    {
      "name": "Discover",
      "ordinal": 1,
      "is_initial": true,
      "is_terminal": false,
      "entry_prompt": "You are in Discover. Load linear42-product and the relevant issue-type skill. Be a product partner: debate what the Linear item should be, challenge assumptions, compare alternatives and recommend a direction. Use Chat artifacts to make ideas and UI proposals concrete. Do not start Figma design or rush to create an issue before its purpose is agreed. Product perspective only.",
      "entry_gate": null,
      "icon": "magnifyingglass",
      "color_light": "#0284C7",
      "color_dark": "#66C8FF",
      "model": "opus[1m]",
      "provider": "claude"
    },
    {
      "name": "Shape",
      "ordinal": 2,
      "is_initial": false,
      "is_terminal": false,
      "entry_prompt": "You are in Shape. Ideate in Chat artifacts: render interactive UI proposals, user flows and relevant edge states, inspect them, show them inline and iterate with the user. Use real product copy. Publish the agreed product brief to Linear. Only after explicit user confirmation of the current artifact direction, record shape/ideation_approved_at. Never infer approval from silence or publishing a document. Clear prior approval when the direction changes. No Figma writes yet.",
      "entry_gate": "{\"namespace\":\"shape\",\"key\":\"discovery_done\",\"op\":\"exists\"}",
      "icon": "square.stack.3d.up",
      "color_light": "#6D28D9",
      "color_dark": "#9D6BFF",
      "model": "opus[1m]",
      "provider": "claude"
    },
    {
      "name": "Design",
      "ordinal": 3,
      "is_initial": false,
      "is_terminal": false,
      "entry_prompt": "You are in Design. The user has approved the artifact direction. Load linear42-product-figma and widget-figma. Build the approved direction in Figma, validate actual frames and edge states against the artifact and brief, and show captured design evidence in Chat artifacts. If a product decision changes, return to Shape and revise the artifact before continuing. Product only.",
      "entry_gate": "{\"and\":[{\"namespace\":\"shape\",\"key\":\"doc\",\"op\":\"exists\"},{\"namespace\":\"shape\",\"key\":\"artifact\",\"op\":\"exists\"},{\"namespace\":\"shape\",\"key\":\"ideation_approved_at\",\"op\":\"exists\"}]}",
      "icon": "pencil.and.ruler",
      "color_light": "#B45309",
      "color_dark": "#FFC766",
      "model": "opus[1m]",
      "provider": "claude"
    },
    {
      "name": "Ready",
      "ordinal": 4,
      "is_initial": false,
      "is_terminal": true,
      "entry_prompt": "You are in Ready. The shape and the Figma design are approved and linked on the Linear issue; nothing is left to do here. Engineering picks the issue up from Linear.",
      "entry_gate": "{\"and\":[{\"namespace\":\"figma\",\"key\":\"links\",\"op\":\"exists\"},{\"namespace\":\"shape\",\"key\":\"approved_at\",\"op\":\"exists\"}]}",
      "icon": "checkmark.circle.fill",
      "color_light": "#15803D",
      "color_dark": "#4CDB73",
      "model": "opus[1m]",
      "provider": "claude"
    }
  ],
  "transitions": [
    {
      "from": "Discover",
      "to": "Shape",
      "description": "discovery is written up and you are ready to shape the feature"
    },
    {
      "from": "Shape",
      "to": "Design",
      "description": "the user explicitly approved the current artifact direction and the agreed product brief is published"
    },
    {
      "from": "Design",
      "to": "Ready",
      "description": "the Figma frames cover every flow and edge case and the user approved them"
    },
    {
      "from": "Design",
      "to": "Shape",
      "description": "the design exposed a gap in the shape"
    },
    {
      "from": "Shape",
      "to": "Discover",
      "description": "the problem itself turned out to be misunderstood"
    },
    {
      "from": "Ready",
      "to": "Shape",
      "description": "the user asked for changes after approval"
    }
  ],
